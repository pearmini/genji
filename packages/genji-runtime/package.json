{
  "name": "genji-runtime",
  "version": "0.3.0",
  "description": "The runtime for Genji",
  "type": "module",
  "main": "src/index.js",
  "files": [
    "src",
    "img"
  ],
  "exports": {
    ".": "./src/index.js",
    "./node": "./src/node.js",
    "./css": "./src/index.css"
  },
  "scripts": {
    "test": "npm run test:lint && npm run test:format && npm run test:unit",
    "test:lint": "eslint src test",
    "test:format": "prettier --check src test",
    "test:unit": "node --test \"test/**/*.test.js\""
  },
  "author": "https://github.com/pearmini",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10"
  },
  "dependencies": {
    "@observablehq/inputs": "^0.12.0",
    "@observablehq/inspector": "^5.0.0",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5"
  }
}
